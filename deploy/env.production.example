# ── Production environment ──────────────────────────────────────────────
# For a self-hosted docker-compose deploy: copy this file to the project root
# as `.env` ON THE SERVER and fill it in. Generate strong random values with:
#   openssl rand -hex 32
# For a Railway + Neon deploy, set these same keys as Railway environment
# variables instead (Railway supplies its own domain/TLS, so DOMAIN is unused
# there) — see DATABASE_URL below for what Neon gives you.

# Your domain (Caddy gets the HTTPS certificate for it automatically) — only
# used by the self-hosted docker-compose path.
DOMAIN=fuel.example.com

# Postgres connection string. Neon/Railway Postgres both give you this exact
# format on their dashboard: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=CHANGE_ME_postgres_connection_string

# Only used by the self-hosted docker-compose path (its "postgres" service) —
# Neon/Railway manage their own Postgres password, so this is unused there.
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Auth — MUST be a long random secret in production (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_long_random_secret

# Shared secret for site agents (agent/.env must use the same value)
AGENT_TOKEN=CHANGE_ME_long_random_token

# Allowed browser origins (your site URL)
CORS_ORIGINS=https://fuel.example.com

# Datakom Rainbow cloud
DK_ENABLED=1
DK_VERBOSE=0
DK_USER=your_datakom_user
DK_PASS=your_datakom_password

# Direct-TCP Modbus defaults (used only when no site agent serves a device)
MODBUS_PORT=502
MODBUS_UNIT_ID=1
